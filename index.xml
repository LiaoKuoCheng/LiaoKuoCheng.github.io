    &gt;@LiaoKuoCheng&lt;/a&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;p&gt;&lt;strong&gt;LinkedIn&lt;/strong&gt;: &lt;a class=&#34;link&#34; href=&#34;https://www.linkedin.com/in/csiecheng/&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;Liao Kuo Cheng&lt;/a&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;p&gt;&lt;strong&gt;Email&lt;/strong&gt;: &lt;a class=&#34;link&#34; href=&#34;mailto:csiecheng@gmail.com&#34; &gt;csiecheng@gmail.com&lt;/a&gt;&lt;/p&gt;
&lt;/li&gt;
