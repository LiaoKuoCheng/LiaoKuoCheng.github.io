&lt;h4 id=&#34;資料庫儲存&#34;&gt;資料庫儲存
&lt;/h4&gt;&lt;p&gt;&lt;img src=&#34;http://localhost:1313/p/%E5%B1%85%E5%AE%B6%E5%9E%8B%E5%81%A5%E5%BA%B7%E6%AA%A2%E6%B8%AC%E7%B3%BB%E7%B5%B1/%E5%91%BC%E5%90%B8%E8%B3%87%E6%96%99%E5%BA%AB.png&#34;
